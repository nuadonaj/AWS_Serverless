# Terraform Variables Template
# Copy this to terraform.tfvars and fill in your actual values
# IMPORTANT: terraform.tfvars should be added to .gitignore and NEVER committed

# Your actual API key (keep this secret!)
api_key = "your-secure-api-key-here"

# AWS configuration for LocalStack
aws_region                  = "us-east-1"
aws_access_key              = "test"
aws_secret_key              = "test"
skip_credentials_validation = true
skip_metadata_api_check     = true
skip_requesting_account_id  = true
s3_use_path_style           = true

# LocalStack endpoint
localstack_endpoint = "http://localhost:4566"

# Application names
function_name   = "sre-backend-lambda"
api_name        = "sre-http-api"
lambda_zip_path = "../backend/lambda.zip"
